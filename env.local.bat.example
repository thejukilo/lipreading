@echo off
REM Copy this file to  env.local.bat  (same folder) and fill in your secrets.
REM env.local.bat is gitignored, so your password never gets committed.

REM --- Supabase Postgres (Session pooler) -----------------------------------
REM From Supabase -> Connect -> Session pooler. Change the scheme to
REM postgresql+psycopg:// and put your DB password in place of YOUR_DB_PASSWORD.
REM Leave this unset to use a local SQLite file instead (fine for testing).
set "LIPREADING_DB_URL=postgresql+psycopg://postgres.mbmajkrmvtlszirgtgre:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

REM --- Optional: legacy HS256 JWT secret ------------------------------------
REM Only needed if your Supabase project uses the legacy shared JWT secret.
REM Newer projects verify via JWKS automatically and don't need this.
REM set "SUPABASE_JWT_SECRET=your-legacy-jwt-secret"
